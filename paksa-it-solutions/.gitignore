/* ============================================================
   PAKSA IT SOLUTIONS — .gitignore
   WordPress Theme Development
   ============================================================ */

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
~$*
*.swp
*.swo
*~

# --- Editor Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.atom/
*.tmproj
*.code-workspace

# --- IDE Project Files ---
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.sln
*.bak

# --- Local Configuration ---
wp-config.php
wp-config.php.*
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Dependency Directories ---
/node_modules/
/vendor/
/composer.lock

# --- Build Artifacts ---
/dist/
/build/
/.cache/
/*.min.css

# --- Logs ---
/logs/
/debug.log
/error.log
/access.log
/*.log

# --- Cache ---
/cache/
/wpcache/
/object-cache.php
/advanced-cache.php
/realpath.php
/blogs.dir/
/upgrade/

# --- Environment Files ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Temporary Files ---
/temp/
/tmp/
/*.tmp
/*.temp

# --- WordPress Specific ---
/wp-content/uploads/
/wp-content/cache/
/wp-content/themes/paksa-it-solutions/assets/images/
/wp-content/themes/paksa-it-solutions/assets/icons/
/wp-content/themes/paksa-it-solutions/assets/fonts/

# --- Mac ---
.AppleDouble
.LSOverride
._*

# --- Theme docs (internal dev notes, not for distribution) ---
/paksa-it-solutions/docs/

# --- Demo content (not for distribution) ---
/paksa-it-solutions/demo/

# --- AI/tool artifacts ---
*.kilo
*.kilocode
.kilocode/
.kilo/
