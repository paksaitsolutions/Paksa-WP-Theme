{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Minimal",
  "styles": {
    "color": { "background": "#ffffff", "text": "#111827" },
    "typography": { "fontFamily": "var:preset|font-family|poppins" },
    "elements": {
      "button": { "border": { "radius": "5px" }, "color": { "background": "#255fc4", "text": "#ffffff" }, ":hover": { "color": { "background": "#174b9e" } } },
      "heading": { "color": { "text": "#111827" } },
      "link": { "color": { "text": "#255fc4" }, ":hover": { "color": { "text": "#174b9e" } } }
    }
  },
  "settings": {
    "color": {
      "palette": [
        { "name": "Primary", "slug": "primary", "color": "#255fc4" },
        { "name": "Primary Hover", "slug": "primary-hover", "color": "#174b9e" },
        { "name": "Secondary", "slug": "secondary", "color": "#111827" },
        { "name": "Accent", "slug": "accent", "color": "#255fc4" },
        { "name": "Accent Light", "slug": "accent-light", "color": "#eef4ff" },
        { "name": "Background", "slug": "bg", "color": "#ffffff" },
        { "name": "Background Alt", "slug": "bg-alt", "color": "#f7f8fa" },
        { "name": "Background Dark", "slug": "bg-dark", "color": "#111827" },
        { "name": "Surface", "slug": "surface", "color": "#ffffff" },
        { "name": "Surface Alt", "slug": "surface-alt", "color": "#f7f8fa" },
        { "name": "Text Primary", "slug": "text", "color": "#111827" },
        { "name": "Text Secondary", "slug": "text-secondary", "color": "#4b5563" },
        { "name": "Text Muted", "slug": "muted", "color": "#9ca3af" },
        { "name": "Text Inverse", "slug": "text-inverse", "color": "#ffffff" },
        { "name": "Border", "slug": "border", "color": "#e5e7eb" },
        { "name": "Success", "slug": "success", "color": "#059669" },
        { "name": "Warning", "slug": "warning", "color": "#d97706" },
        { "name": "Error", "slug": "error", "color": "#dc2626" },
        { "name": "Info", "slug": "info", "color": "#255fc4" }
      ]
    },
    "custom": {
      "radius-sm": "3px",
      "radius-md": "5px",
      "radius-lg": "8px",
      "radius-xl": "12px"
    }
  }
}
