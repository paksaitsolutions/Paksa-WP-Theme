{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 2,
    "settings": {
        "color": {
            "custom": true,
            "duotone": true,
            "gradients": true,
            "palette": [
                { "name": "Primary",          "slug": "primary",       "color": "#1a365d" },
                { "name": "Primary Hover",     "slug": "primary-hover", "color": "#2a4a7f" },
                { "name": "Secondary",         "slug": "secondary",     "color": "#2b6cb0" },
                { "name": "Accent",            "slug": "accent",        "color": "#00b5d8" },
                { "name": "Accent Light",      "slug": "accent-light",  "color": "#e6f9fd" },
                { "name": "Background",        "slug": "bg",            "color": "#ffffff" },
                { "name": "Background Alt",    "slug": "bg-alt",        "color": "#f7fafc" },
                { "name": "Background Dark",   "slug": "bg-dark",       "color": "#1a202c" },
                { "name": "Text Primary",      "slug": "text",          "color": "#1a202c" },
                { "name": "Text Secondary",    "slug": "text-secondary","color": "#4a5568" },
                { "name": "Text Muted",        "slug": "text-muted",    "color": "#718096" },
                { "name": "Text Inverse",      "slug": "text-inverse",  "color": "#ffffff" },
                { "name": "White",             "slug": "white",         "color": "#ffffff" },
                { "name": "Border",            "slug": "border",        "color": "#e2e8f0" },
                { "name": "Success",           "slug": "success",       "color": "#38a169" },
                { "name": "Warning",           "slug": "warning",       "color": "#d69e2e" },
                { "name": "Error",             "slug": "error",         "color": "#e53e3e" },
                { "name": "Info",              "slug": "info",          "color": "#3182ce" }
            ]
        },
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
                    "slug": "inter",
                    "name": "Inter"
                },
                { "fontFamily": "serif",     "slug": "serif",     "name": "Serif" },
                { "fontFamily": "monospace", "slug": "monospace", "name": "Monospace" }
            ],
            "fontSizes": [
                { "name": "Small",   "slug": "small",   "size": "0.875rem" },
                { "name": "Normal",  "slug": "normal",  "size": "1rem" },
                { "name": "Large",   "slug": "large",   "size": "1.125rem" },
                { "name": "Heading", "slug": "heading", "size": "1.5rem" },
                { "name": "Display", "slug": "display", "size": "clamp(2.5rem, 5vw, 4rem)" }
            ]
        },
        "spacing": {
            "customSpacing": true,
            "padding": true,
            "margin": true,
            "units": ["rem", "px", "%", "vw"]
        },
        "border": {
            "custom": true,
            "radius": true,
            "style": true,
            "width": true,
            "color": true
        },
        "layout": {
            "contentSize": "1280px",
            "wideSize": "1440px",
            "allowGapClass": true
        },
        "custom": {
            "container": "1280px",
            "container-narrow": "720px",
            "container-wide": "1440px",
            "transition-fast": "150ms ease",
            "transition-base": "250ms ease",
            "transition-slow": "350ms ease"
        }
    },
    "styles": {
        "color": {
            "background": "var(--pk-bg)",
            "text": "var(--pk-text)",
            "link": "var(--pk-text-link)"
        },
        "typography": {
            "fontFamily": "var(--pk-font-sans)",
            "fontSize": "1rem",
            "lineHeight": "1.7"
        },
        "elements": {
            "link": {
                "color": "var(--pk-text-link)",
                "textDecoration": "none",
                ":hover": {
                    "color": "var(--pk-text-link-hover)"
                },
                ":focus-visible": {
                    "outline": "3px solid var(--pk-accent)",
                    "outlineOffset": "2px"
                }
            },
            "heading": {
                "fontWeight": "700",
                "lineHeight": "1.15",
                "color": "var(--pk-text)"
            },
            "button": {
                "fontFamily": "var(--pk-font-sans)",
                "fontWeight": "600",
                "fontSize": "0.9375rem",
                "borderRadius": "var(--pk-radius-md)",
                "padding": "0.75rem 1.5rem",
                "cursor": "pointer"
            },
            "caption": {
                "fontSize": "0.75rem",
                "color": "var(--pk-text-muted)",
                "lineHeight": "1.5"
            }
        },
        "blocks": {
            "core/paragraph": {
                "typography": {
                    "fontSize": "1rem",
                    "lineHeight": "1.7",
                    "color": "var(--pk-text)"
                },
                "spacing": {
                    "marginBottom": "1rem"
                }
            },
            "core/heading": {
                "typography": {
                    "fontWeight": "700",
                    "lineHeight": "1.15",
                    "color": "var(--pk-text)"
                }
            },
            "core/button": {
                "elements": {
                    "link": {
                        "color": "var(--pk-text-inverse)",
                        "backgroundColor": "var(--pk-primary)",
                        "borderRadius": "var(--pk-radius-md)",
                        ":hover": {
                            "backgroundColor": "var(--pk-primary-hover)"
                        }
                    }
                }
            },
            "core/cover": {
                "color": {
                    "text": "var(--pk-text-inverse)"
                }
            },
            "core/group": {
                "spacing": {
                    "padding": {
                        "top": "0",
                        "bottom": "0",
                        "left": "0",
                        "right": "0"
                    }
                }
            }
        },
        "css": "/* Nexus Business Theme — Additional Styles */\n/* Design tokens are loaded from assets/css/variables.css */\n/* Animations are loaded from assets/css/animations.css */"
    }
}
